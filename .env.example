# --- Required ---------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...          # console.anthropic.com -> API Keys
APP_PASSWORD=choose-a-strong-password # what you type to unlock Jarvis
SECRET_KEY=paste-a-long-random-string # signs your login cookie
PUBLIC_URL=https://your-app.up.railway.app

# --- Optional ---------------------------------------------------------------
DATA_DIR=/data                        # where the SQLite database lives (mount a volume here)
JARVIS_MODEL=claude-opus-5-5
JARVIS_EFFORT=medium                  # low | medium | high
JARVIS_OWNER_NAME=Sattanathan
JARVIS_TIMEZONE=Asia/Dubai

# Gmail + Calendar (see README, step 4)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Local testing only: skips the password requirement
# JARVIS_DEV=1
