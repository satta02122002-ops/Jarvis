{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jarvis",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  // The iPhone web app. Files in ./public are served directly; everything else reaches the Worker.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "none",
    "run_worker_first": ["/api/*", "/google/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "jarvis",
      "database_id": "6f16ac7b-6d56-4b4a-836f-20e5f715e7fb",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "OWNER_NAME": "Sattanathan",
    "JARVIS_MODEL": "claude-opus-5-5",
    "JARVIS_EFFORT": "medium"
  },
  "observability": { "enabled": true }
  // Secrets (set in the Cloudflare dashboard → jarvis → Settings → Variables and Secrets, never committed):
  //   ANTHROPIC_API_KEY, APP_PASSWORD, SECRET_KEY, GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET
}
